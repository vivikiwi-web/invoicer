# Playwright (local/dev only — never production)
# Defaults to a dedicated Vite port (5174) so tests do not reuse a stale `npm run dev`.
PLAYWRIGHT_PORT=5174
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5174
E2E_EMAIL=
E2E_PASSWORD=

# PostHog (optional). Without a token, analytics is a no-op.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
