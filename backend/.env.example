NODE_ENV=development
PORT=8000

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Set to false only if a local DB uses a self-signed cert
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=aimb_token
# Use "none" only when the SPA is on a different site (requires HTTPS)
COOKIE_SAMESITE=lax

# Frontend origin (CORS) — comma-separated
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
